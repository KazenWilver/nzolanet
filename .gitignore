# ============================================================
# NzolaNet — .gitignore
# Cobre: Node (build-pdf), Angular (frontend futuro), .NET (backend futuro),
# Visual Studio / Rider / VS Code, SQL Server, e ficheiros do SO
# ============================================================

# ---------- Sistema Operativo ----------
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
*.swp
*.swo
*~

# ---------- IDEs ----------
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs

# ---------- Node / Angular (frontend) ----------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
.npm/
.yarn/
.angular/
dist/
tmp/
out-tsc/
bazel-out/
.angular-cli.json.bak
*.log

# ---------- .NET / ASP.NET (backend) ----------
bin/
obj/
*.dll
*.pdb
*.exe
*.cache
*.vshost.*
*.lock.json
*.nupkg
*.snupkg
.vs/
artifacts/
publish/
PublishProfiles/
*.publishsettings
*.pubxml
*.pubxml.user
TestResults/
[Tt]est[Rr]esult*/
*.VisualState.xml
*.coverage
*.coveragexml

# ---------- SQL Server ----------
*.mdf
*.ldf
*.ndf
*.bak
LocalDB/

# ---------- Secrets / Config sensíveis ----------
appsettings.Development.json
appsettings.Local.json
appsettings.*.local.json
*.env
.env
.env.local
.env.*.local
secrets.json
*.pfx
*.p12
*.key

# ---------- Uploads (não versionar conteúdo do utilizador) ----------
wwwroot/uploads/
uploads/

# ---------- Build / Cache ----------
.cache/
.parcel-cache/
.next/
.nuxt/
coverage/
*.tsbuildinfo

# ---------- Build-pdf (mantemos os scripts e package.json, mas não o node_modules nem outputs grandes) ----------
build-pdf/node_modules/
# Mantemos os PDFs/HTMLs gerados pois ficam servidos pelo GitHub Pages

# ---------- Extras ----------
extras/
