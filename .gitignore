# ============================================================
# NzolaNet — .gitignore
# Cobre: Node (build-pdf), Angular (frontend futuro), .NET (backend futuro),
# Visual Studio / Rider / VS Code, SQL Server, e ficheiros do SO
# ============================================================

# ---------- Sistema Operativo ----------
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
*.swp
*.swo
*~

# ---------- IDEs ----------
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs

# ---------- Node / Angular (frontend) ----------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
.npm/
.yarn/
.angular/
dist/
tmp/
out-tsc/
bazel-out/
.angular-cli.json.bak
*.log

# ---------- .NET / ASP.NET (backend) ----------
bin/
obj/
*.dll
*.pdb
*.exe
*.cache
*.vshost.*
*.lock.json
*.nupkg
*.snupkg
.vs/
artifacts/
publish/
PublishProfiles/
*.publishsettings
*.pubxml
*.pubxml.user
TestResults/
[Tt]est[Rr]esult*/
*.VisualState.xml
*.coverage
*.coveragexml

# ---------- SQL Server ----------
*.mdf
*.ldf
*.ndf
*.bak
LocalDB/

# ---------- Secrets / Config sensíveis ----------
appsettings.Development.json
appsettings.Local.json
appsettings.*.local.json
frontend/src/environments/environment.ngrok.ts
*.env
.env
.env.local
.env.*.local
secrets.json
*.pfx
*.p12
*.key

# ---------- Uploads (não versionar conteúdo do utilizador) ----------
**/wwwroot/uploads/*
!**/wwwroot/uploads/.gitkeep
**/wwwroot/messages/*
!**/wwwroot/messages/.gitkeep
original-*.png

# ---------- Build / Cache ----------
.cache/
.parcel-cache/
.next/
.nuxt/
coverage/
*.tsbuildinfo

# ---------- Playwright (artefactos de teste) ----------
**/test-results/
**/playwright-report/
**/playwright/.cache/

# ---------- AI / IDE (configuração local, não versionar) ----------
.claude/
.cursor/

# ---------- Extras (referências locais: design, clones, prompts, PDFs) ----------
extras/

# ---------- Léxico Fimbu (manter só ficheiros usados em runtime pela API) ----------
palavras_angolanas/dicionario_angolano_train.jsonl
palavras_angolanas/dicionario_angolano_full.jsonl
palavras_angolanas/cache_words.jsonpostgres/supabase-initial.sql
postgres/supabase-apply.sql

